# Copier ce fichier vers .env, puis renseigner la clé et le mot de passe.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Délai par appel, transmis aussi au serveur Google (secondes).
GEMINI_TIMEOUT_SECONDS=20
# Secours OpenAI : une seule tentative, avec sa propre clé API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
SQLITE_DB_PATH=DWH_fictive_10000_lignes.sqlite
DICTIONNAIRE_PATH=Dictionnaire_donnees_DWH_fictive_SQLite.md
APP_DB_PATH=app.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
APP_BASE_URL=http://localhost:8000
# Mettre à 1 lorsque l'application est servie en HTTPS.
COOKIE_SECURE=0

# MCP local : les colonnes classées RGPD sont bloquées par défaut.
MCP_BLOQUER_RGPD=1
MCP_TRANSPORT=stdio
MCP_SQL_TIMEOUT=12
MCP_MAX_ROWS=500
MCP_MAX_CHARS=60000
MCP_MAX_SQL_CHARS=100000
MCP_MAX_CONCURRENT=4
# Liste de tables séparées par des virgules ; vide = toutes les tables.
MCP_TABLES_AUTORISEES=

# Optionnel : envoi des liens de réinitialisation par e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Groq : fournisseur propose dans le chat avec Gemini.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
