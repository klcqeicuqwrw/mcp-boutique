{"date": "2026-09-30T11:09:22", "outil": "executer_requete_sql", "statut": "ok", "lignes": 35, "ms": 0, "sql": "SELECT COALESCE(g.Libelle_departement, p.\"Code_département\", 'Département non renseigné') AS departement, p.\"Code_département\" AS code_departement, l.Code_nature_lot, l.Libelle_nature_lot, l.Code_type_lot, l.Libelle_type_lot, COUNT(DISTINCT l.ID_lot) AS nombre_lots FROM DWH_Lot AS l LEFT JOIN DWH_Patrimoine AS p ON p.ID_patrimoine = l.ID_patrimoine LEFT JOIN DWH_Geographie AS g ON g.Code_INSEE_commune = p.Code_INSEE_commune GROUP BY departement, code_departement, l.Code_nature_lot, l.Libelle_nature_lot, l.Code_type_lot, l.Libelle_type_lot ORDER BY code_departement, l.Code_nature_lot, l.Code_type_lot LIMIT 100"}
{"date": "2026-09-30T11:09:32", "outil": "executer_requete_sql", "statut": "ok", "lignes": 5, "ms": 0, "sql": "SELECT COALESCE(p.\"Code_département\", 'Non renseigné') AS code_departement, COUNT(DISTINCT l.ID_lot) AS nombre_lots, COUNT(DISTINCT CASE WHEN l.ID_RPLS IS NOT NULL AND TRIM(l.ID_RPLS) <> '' THEN l.ID_lot END) AS lots_avec_id_rpls FROM DWH_Lot AS l LEFT JOIN DWH_Patrimoine AS p ON p.ID_patrimoine = l.ID_patrimoine GROUP BY code_departement ORDER BY code_departement LIMIT 100"}
