{"date": "2026-10-01T10:56:34", "outil": "executer_requete_sql", "statut": "ok", "lignes": 1, "ms": 0, "sql": "WITH baux_actuels AS (SELECT ID_bail, ID_client, ID_logement FROM Bail WHERE Statut_bail = 'En cours' AND Date_debut_occupation <= '2026-10-01' AND (Date_fin_occupation IS NULL OR Date_fin_occupation >= '2026-10-01')), clients_actuels AS (SELECT DISTINCT ID_client FROM baux_actuels), occupants_actuels AS (SELECT DISTINCT o.ID_occupant FROM Occupant o JOIN clients_actuels c ON c.ID_client = o.ID_client) SELECT (SELECT COUNT(*) FROM baux_actuels) AS nombre_baux_actuels, (SELECT COUNT(*) FROM clients_actuels) AS titulaires_distincts, (SELECT COUNT(*) FROM occupants_actuels) AS personnes_associees, (SELECT COUNT(*) FROM clients_actuels) + (SELECT COUNT(*) FROM occupants_actuels) AS total_personnes_selon_definition FROM (SELECT 1) LIMIT 1"}
{"date": "2026-10-01T10:56:40", "outil": "executer_requete_sql", "statut": "ok", "lignes": 30, "ms": 0, "sql": "WITH baux_actuels AS (SELECT ID_client, ID_logement FROM Bail WHERE Statut_bail = 'En cours' AND Date_debut_occupation <= '2026-10-01' AND (Date_fin_occupation IS NULL OR Date_fin_occupation >= '2026-10-01')), personnes AS (SELECT c.Nom_client AS nom, c.Prenom_client AS prenom, 'Titulaire du bail' AS role, l.Code_logement AS logement FROM baux_actuels b JOIN Client c ON c.ID_client = b.ID_client JOIN Logement l ON l.ID_logement = b.ID_logement UNION ALL SELECT o.Nom_occupant AS nom, o.Prenom_occupant AS prenom, 'Personne liée au titulaire' AS role, l.Code_logement AS logement FROM Occupant o JOIN baux_actuels b ON b.ID_client = o.ID_client JOIN Logement l ON l.ID_logement = b.ID_logement) SELECT nom, prenom, role, logement FROM personnes ORDER BY nom COLLATE NOCASE, prenom COLLATE NOCASE, role, logement LIMIT 30"}
{"date": "2026-10-01T10:57:39", "outil": "valeurs_distinctes", "statut": "ok", "lignes": 2, "ms": 0, "sql": "SELECT \"Statut_bail\" AS valeur, COUNT(*) AS nb FROM \"Bail\" GROUP BY \"Statut_bail\" ORDER BY nb DESC LIMIT 30"}
{"date": "2026-10-01T10:57:46", "outil": "executer_requete_sql", "statut": "ok", "lignes": 126, "ms": 16, "sql": "SELECT DISTINCT o.Nom_occupant AS nom, o.Prenom_occupant AS prenom, o.Lien_parente AS lien, l.Code_logement AS logement FROM Occupant o JOIN Bail b ON b.ID_client = o.ID_client JOIN Logement l ON l.ID_logement = b.ID_logement WHERE b.Statut_bail = 'En cours' AND b.Date_debut_occupation <= '2026-10-01' AND (b.Date_fin_occupation IS NULL OR b.Date_fin_occupation >= '2026-10-01') ORDER BY o.Nom_occupant COLLATE NOCASE, o.Prenom_occupant COLLATE NOCASE, l.Code_logement LIMIT 200"}
{"date": "2026-10-01T10:57:54", "outil": "executer_requete_sql", "statut": "ok", "lignes": 1, "ms": 15, "sql": "WITH occupants_actuels AS (SELECT DISTINCT o.ID_occupant FROM Occupant o JOIN Bail b ON b.ID_client = o.ID_client WHERE b.Statut_bail = 'En cours' AND b.Date_debut_occupation <= '2026-10-01' AND (b.Date_fin_occupation IS NULL OR b.Date_fin_occupation >= '2026-10-01')) SELECT COUNT(*) AS nombre_occupants FROM occupants_actuels"}
{"date": "2026-10-01T10:58:02", "outil": "executer_requete_sql", "statut": "ok", "lignes": 50, "ms": 0, "sql": "WITH actifs AS (SELECT o.ID_occupant, o.Nom_occupant, o.Prenom_occupant, o.Lien_parente, l.Code_logement FROM Occupant o JOIN Bail b ON b.ID_client = o.ID_client JOIN Logement l ON l.ID_logement = b.ID_logement WHERE b.Statut_bail = 'En cours' AND b.Date_debut_occupation <= '2026-10-01' AND (b.Date_fin_occupation IS NULL OR b.Date_fin_occupation >= '2026-10-01')), liste AS (SELECT ID_occupant, Nom_occupant, Prenom_occupant, Lien_parente, GROUP_CONCAT(DISTINCT Code_logement) AS logements FROM actifs GROUP BY ID_occupant, Nom_occupant, Prenom_occupant, Lien_parente) SELECT Nom_occupant AS nom, Prenom_occupant AS prenom, Lien_parente AS lien, logements FROM liste ORDER BY nom COLLATE NOCASE, prenom COLLATE NOCASE, ID_occupant LIMIT 50 OFFSET 50"}
