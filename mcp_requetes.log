{"date": "2026-09-30T11:44:15", "outil": "executer_requete_sql", "statut": "ok", "lignes": 10, "ms": 0, "sql": "SELECT Nom_occupant, Prenom_occupant, CAST(strftime('%Y', 'now') AS INTEGER) - CAST(strftime('%Y', Date_naissance_occupant) AS INTEGER) - (strftime('%m-%d', 'now') < strftime('%m-%d', Date_naissance_occupant)) AS Age_ans FROM DWH_Occupant WHERE Date_naissance_occupant IS NOT NULL ORDER BY Date_naissance_occupant DESC, Nom_occupant, Prenom_occupant LIMIT 10"}
